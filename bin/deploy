#!/usr/bin/env bash
# One-command full-bundle deploy for ANY developer: builds + pushes the images to
# ghcr and rolls them out on the droplet (which only pulls). Self-bootstrapping —
# it checks prerequisites, logs in to ghcr, ensures the buildx builder, then:
#   1. build + push kamailio        (Kamal never builds accessory images)
#   2. kamal deploy                 (builds/pushes/redeploys the cabinet web app)
#   3. accessory reboot             (pulls fresh images, restarts kamailio + detoken)
#
# Setup (once), see DEPLOY.md:
#   - copy .deploy.env.example -> .deploy.env and fill GHCR_USER / GHCR_TOKEN
#     (a ghcr token that can push to the org: org member + write:packages)
#   - get .env.droplet from passdb (real secrets), put it at the repo root
#   - make sure your ssh key is in the droplet's authorized_keys
# Then just:  bin/deploy
set -euo pipefail
cd "$(dirname "$0")/.."

# ---- config (env or .deploy.env; sane defaults) --------------------------------
[ -f .deploy.env ] && set -a && . ./.deploy.env && set +a
NS="${WR_GHCR_NS:-uatechpeople}"
DROPLET="${WR_DROPLET:-157.245.75.233}"
BUILDER="${WR_BUILDX:-wrbuild}"
KAMAILIO_IMG="ghcr.io/${NS}/wr_lane-kamailio:latest"

die() { echo "ERROR: $*" >&2; exit 1; }
step() { echo; echo "==> $*"; }

# ---- preflight -----------------------------------------------------------------
step "[preflight] checking prerequisites"
command -v docker >/dev/null || die "docker not found"
docker info >/dev/null 2>&1 || die "docker daemon not reachable (start OrbStack/Docker Desktop)"
[ -n "${GHCR_USER:-}" ]  || die "GHCR_USER not set (put it in .deploy.env — see .deploy.env.example)"
[ -n "${GHCR_TOKEN:-}" ] || die "GHCR_TOKEN not set (ghcr token with write:packages on the org)"
[ -f .env.droplet ]      || die ".env.droplet missing at repo root — get it from passdb"
ssh -o BatchMode=yes -o ConnectTimeout=8 "root@${DROPLET}" true 2>/dev/null \
  || die "cannot ssh root@${DROPLET} — add your key to the droplet authorized_keys (and ssh-add it)"
echo "    ok: docker, ghcr creds, .env.droplet, ssh -> ${DROPLET}"

# ---- ghcr login + builder ------------------------------------------------------
step "[login] ghcr.io as ${GHCR_USER}"
printf '%s' "$GHCR_TOKEN" | docker login ghcr.io -u "$GHCR_USER" --password-stdin >/dev/null \
  || die "ghcr login failed (check GHCR_USER/GHCR_TOKEN)"
export KAMAL_REGISTRY_PASSWORD="$GHCR_TOKEN"   # Kamal uses this for the droplet login

docker buildx inspect "$BUILDER" >/dev/null 2>&1 || docker buildx create --name "$BUILDER" >/dev/null
docker buildx use "$BUILDER"

# ---- 1/3 kamailio image --------------------------------------------------------
step "[1/3] build + push kamailio -> ${KAMAILIO_IMG}"
docker buildx build --platform linux/amd64 --builder "$BUILDER" \
  -t "$KAMAILIO_IMG" -f ./sip_proxy/docker/Dockerfile --push ./sip_proxy

# ---- 2/3 cabinet (kamal builds + pushes + deploys) -----------------------------
step "[2/3] kamal deploy (cabinet web app)"
./bin/kamal deploy

# ---- 3/3 accessories -----------------------------------------------------------
step "[3/3] reboot accessories (kamailio + detoken)"
./bin/kamal accessory reboot kamailio
./bin/kamal accessory reboot detoken

# ---- verify --------------------------------------------------------------------
step "[verify] droplet"
curl -fs -o /dev/null -w "    cabinet /health -> HTTP %{http_code}\n" "http://${DROPLET}/health" || echo "    /health check failed"
ssh -o BatchMode=yes "root@${DROPLET}" 'docker ps --filter name=wr_lane --format "    {{.Names}}\t{{.Status}}"'
echo; echo "==> done. full bundle deployed to ${DROPLET} from ghcr.io/${NS}/*"
