# Copy to .env and fill in. For a client hand-off we deliver this file already
# filled with the WinRiders values — the client fills MY_PUBLIC_IP and their SIP-trunk creds.

# ---- this host ----
MY_PUBLIC_IP=<your-server-public-ip>

# ---- cabinet (your tokenization keys — keep secret; generated per client) ----
FF3_KEY=<32/48/64 hex chars>
FF3_TWEAK=D8E7920AFA330A73
ROUTE_DIGIT=9
DECRYPT_KEY=<shared only with your SIP proxy>
CABINET_USER=admin
CABINET_PASSWORD=<your cabinet password>
CLIENT_PREFIX=<your routing prefix, e.g. 123000>

# Push-to-WinRiders button/endpoint: hidden unless set to true
WR_PUSH_ENABLED=false

# ---- provided by WinRiders (do not change) ----
WEBHOOK_KEY=<given-by-winriders>
ELEVEN_LAB_MMD_TOKEN=<given-by-winriders>

# ---- your SIP trunk (fill with your own carrier creds) ----
MMD_GW_IP=<your carrier SIP gateway host/IP>
MMD_GW_PORT=<your carrier SIP port, e.g. 5060>
MMD_AUTH_USER=<your SIP account login>
MMD_AUTH_PASS=<your SIP account password>
