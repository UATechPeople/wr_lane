# ===== креды вашего SIP-транка (ЗАПОЛНИТЕ СВОИМИ) =====
# Данные вашего оператора связи / SIP-транка. Кабинет запустится и без них
# (можно токенизировать номера), но обзвон поедет только после того, как вы
# впишете сюда свои значения и перезапустите (./up.sh).
#
# Заполните ОДИН блок — тот, что соответствует вашему оператору.

# --- вариант А: оператор даёт логин и пароль ---
TRUNK_DIGEST_HOST=
TRUNK_DIGEST_PORT=
TRUNK_DIGEST_USER=
TRUNK_DIGEST_PASS=

# --- вариант Б: оператор пускает по IP вашего сервера ---
TRUNK_IPAUTH_HOST=
TRUNK_IPAUTH_PORT=
# технический префикс набора — оставьте пустым, если оператор его не требует
TRUNK_IPAUTH_PREFIX=

# ===== ваши настройки (ключи шифрования генерируются в keys.env скриптом up.sh) =====
CABINET_USER=admin
ROUTE_DIGIT=9
MY_PUBLIC_IP=
CABINET_DOMAIN=
WR_PUSH_ENABLED=false
