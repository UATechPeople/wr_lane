# ===== provided by WinRiders (не меняйте) =====
CLIENT_PREFIX=123000
# Заголовок X-API-Key, который WinRiders шлёт на ваш прокси. Значением выбирается
# ветка транка: заполните ключ той ветки, через которую идёт ваш оператор.
TRUNK_IPAUTH_API_KEY=DF94AS13GBT034e40o0
TRUNK_DIGEST_API_KEY=wr_fc1c2d4223996d2268b4302454312e49

# ===== подключение к WinRiders (заполняет WinRiders перед выдачей) =====
WR_BASE_URL=https://wr-core-production2.up.railway.app
WR_SLUG=
WR_API_KEY=
WR_PLAYER_SEGMENT=hidden_base
WR_EVENT_TYPE=player.registered
WR_COHORT=

# ===== креды вашего SIP-транка (ЗАПОЛНИТЕ СВОИМИ) =====
# Данные вашего оператора связи / SIP-транка. Кабинет запустится и без них
# (можно токенизировать номера), но обзвон поедет только после того, как вы
# впишете сюда свои значения и перезапустите (./up.sh).
#
# Заполните ОДИН блок — тот, что соответствует вашему оператору.

# --- вариант А: оператор даёт логин и пароль ---
TRUNK_DIGEST_HOST=
TRUNK_DIGEST_PORT=
TRUNK_DIGEST_USER=
TRUNK_DIGEST_PASS=

# --- вариант Б: оператор пускает по IP вашего сервера ---
TRUNK_IPAUTH_HOST=
TRUNK_IPAUTH_PORT=
# технический префикс набора — оставьте пустым, если оператор его не требует
TRUNK_IPAUTH_PREFIX=

# ===== ваши настройки (ключи шифрования генерируются в keys.env скриптом up.sh) =====
CABINET_USER=admin
ROUTE_DIGIT=9
MY_PUBLIC_IP=
CABINET_DOMAIN=
WR_PUSH_ENABLED=false

# RTP media port range relayed by the SIP proxy — open these in the firewall (UDP)
RTP_PORT_MIN=30000
RTP_PORT_MAX=30500

# Only if the server sits behind NAT (its public IP is NOT on a local interface):
# RTPENGINE_INTERFACE=<private-ip>!<public-ip>     e.g. 10.0.0.5!203.0.113.7
# Check with:  ip -4 addr show | grep inet
RTPENGINE_INTERFACE=
