# Copy to .deploy.env (gitignored) and fill in. Used by bin/deploy.
# GHCR token that can push the images to the org (org member + write:packages).
# Get the shared deploy token + .env.droplet from passdb — do NOT paste personal tokens around.
GHCR_USER=your-ghcr-username
GHCR_TOKEN=ghp_or_gho_token_here

# Optional overrides (defaults shown):
# WR_GHCR_NS=uatechpeople
# WR_DROPLET=157.245.75.233
