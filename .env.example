# Generate real values with:  bun run keygen
# KEEP FF3_KEY AND DECRYPT_KEY SECRET. They never leave the client side.

PORT=3500

# FF3-1 key, hex (32 chars = 128-bit). The token<->number bijection. SECRET.
FF3_KEY=EF4359D8D580AA4F7F036D6F04FC6A94

# FF3-1 tweak, hex (16 chars = 64-bit). Not secret. Fixed -> deterministic tokens.
FF3_TWEAK=D8E7920AFA330A73

# First digit of every token (1-9). Constant -> token length is always 15 (hides real length).
ROUTE_DIGIT=9

# Shared secret: kamailio -> /api/decrypt. SECRET.
DECRYPT_KEY=change-me-decrypt-secret

# Operator HTTP Basic Auth for the cabinet UI + data API. Unset both -> auth disabled (dev).
CABINET_USER=admin
CABINET_PASSWORD=change-me

# This client's routing prefix (one per client, e.g. 123000 / 223000). Kamailio routes on it;
# /detokenize strips it. Mirror this into Platform' per-client VoiceService.techPrefix.
CLIENT_PREFIX=123000

DB_PATH=cabinet.sqlite

# Platform client-integration target (POST /webhook/clients/{slug}/events).
WR_BASE_URL=https://your-platform-host
WR_SLUG=your-slug
WR_API_KEY=your-wr-api-key
# Label that turns the flat token list into a segment on the WR side.
WR_PLAYER_SEGMENT=hidden_base
# WR_COHORT=
# WR_EVENT_TYPE=player.registered

# Public IP of the server. Fill manually (no shell substitution in .env).
MY_PUBLIC_IP=

DB_URL=sqlite:///var/lib/kamailio/kamailio.db
DETOKEN_URL=http://cabinet:3501/detokenize

# Bearer token for CDR webhook
WEBHOOK_KEY=change-me-webhook-secret

# Voice AI API keys per provider trunk (X-API-Key header)
VOICEAI_CARRIER_C_TOKEN=
VOICEAI_CARRIER_A_TOKEN=
VOICEAI_CARRIER_B_TOKEN=

# CarrierC
CARRIER_C_GW_IP=
CARRIER_C_GW_PORT=5060
CARRIER_C_TECH_PREFIX=

# CARRIER_A
CARRIER_A_GW_IP=
CARRIER_A_GW_PORT=5060
CARRIER_A_AUTH_USER=
CARRIER_A_AUTH_PASS=

# carrier_b
CARRIER_B_GW_IP=
CARRIER_B_GW_PORT=5060



