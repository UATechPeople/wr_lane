{
  "name": "wr-hidden-numbers",
  "version": "0.1.0",
  "description": "Client-side cabinet: hold the real number base, ship only FF3-1 tokens to WinRiders, decrypt on egress. Elysia (Bun) API + React UI (pre-built with Bun.build + Tailwind, served from dist/).",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build:web": "bun scripts/build-web.ts",
    "dev": "bun run build:web && bun --watch src/index.ts",
    "start": "bun run build:web && bun src/index.ts",
    "keygen": "bun -e \"const c=require('crypto');console.log('FF3_KEY='+c.randomBytes(16).toString('hex').toUpperCase());console.log('FF3_TWEAK='+c.randomBytes(8).toString('hex').toUpperCase());console.log('DECRYPT_KEY='+c.randomBytes(24).toString('hex'))\"",
    "test": "bun test"
  },
  "dependencies": {
    "@elysiajs/static": "^1.1.1",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "clsx": "^2.1.1",
    "elysia": "^1.1.26",
    "ff3": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "bun-types": "latest"
  }
}
